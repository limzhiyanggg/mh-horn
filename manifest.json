{
  "manifest_version": 3,
  "name": "MH Horn Alert",
  "version": "1.0",
  "description": "Desktop notification when your MouseHunt horn is ready.",

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://www.mousehuntgame.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "offscreen",
    "scripting",
    "tabs"
  ],

  "host_permissions": [
    "*://www.mousehuntgame.com/*"
  ],

  "web_accessible_resources": [
    {
      "resources": ["injector.js", "assets/horn.ogg", "assets/king-reward.mp3"],
      "matches": ["*://www.mousehuntgame.com/*"]
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "MH Horn Alert",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
